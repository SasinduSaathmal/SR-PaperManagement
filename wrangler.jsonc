{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sr-papermanagement",
  "main": "worker/index.js",
  "keep_vars": true,
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "previews": {},
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}

